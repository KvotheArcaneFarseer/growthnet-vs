+            return norm_slice(s)
+        pad = 8
+        row0 = max(0, int(mask_idx[:, 0].min()) - pad)
+        row1 = min(s.shape[0], int(mask_idx[:, 0].max()) + pad + 1)
+        col0 = max(0, int(mask_idx[:, 1].min()) - pad)
